{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "source", "scope", "suite_digest", "fixture_digest", "policy_digest", "sample_digests", "criteria"],
  "properties": {
    "version": {"type": "string"},
    "source": {"type": "string", "minLength": 1},
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "case_id", "layer", "executor", "title", "expected", "severity", "impact", "required"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "case_id": {"type": "string", "minLength": 1},
          "layer": {"enum": ["L1", "L2", "L3", "L4"]},
          "executor": {"enum": ["bandit", "playwright"]},
          "required": {"type": "boolean"}
        }
      }
    }
  }
}
