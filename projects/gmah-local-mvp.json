  ],
  "specification": {
    "title": "GMAH 本地 MVP 业务验收",
    "scope": "GMAH 本地 MVP：模型设计审批接口和页面用例，生产构建、仓库回归、代码及依赖扫描，会话负载和 Redis/PostgreSQL 重启恢复；外部模型、QQ、远程 MCP 与真实批改系统不在本次范围。",
    "environment": {
      "mode": "service",
      "runtime": "python",
      "entrypoint": "src/agent_workflow/api/app.py",
      "port": 19300,
      "ready_path": "/healthz",
      "recipe": "gmah-v1"
    },
    "requirements": [
      {
        "id": "APPROVAL-API",
        "title": "人工审批接口流程",
        "source": "README",
        "quote": "- 审批：查看 pending approval，并批准或拒绝。",
        "priority": "P2",
        "disposition": "required",
        "reason": "",
        "scenarios": [
          {
            "id": "M-1900252adcaf",
            "title": "最低分数边界下批准审批",
            "dimension": "boundary",
            "engine": "api",
            "steps": [
              {
                "kind": "http",
                "method": "POST",
                "path": "/sessions/run",
                "body": {
                  "user_id": "${run_id}",
                  "message": "${feedback}",
                  "tool_call": {
                    "tool_name": "publish_grade",
                    "arguments": {
                      "submission_id": "submission-1",
                      "rubric_version": "v1",
                      "score": "${score}",
                      "feedback_markdown": "${feedback}"
                    }
                  }
                },
                "headers": {},
                "status": 200,
                "assertions": [
                  {
                    "pointer": "/approval_required",
                    "operator": "equals",
                    "value": true
                  },
                  {
                    "pointer": "/tool_result",
                    "operator": "equals",
                    "value": null
                  }
                ],
                "capture": {
                  "thread": "/thread_id",
                  "approval": "/pending_approval/approval_id"
                }
              },
              {
                "kind": "http",
                "method": "POST",
                "path": "/approvals/${approval}/decide",
                "body": {
                  "approved_by": "验收复核员",
                  "approved": "${approved}",
                  "reason": "验收验证"
                },
                "headers": {},
                "status": 200,
                "assertions": [
                  {
                    "pointer": "/state/approval_status",
                    "operator": "equals",
                    "value": "${expected}"
                  }
                ],
                "capture": {}
              },
              {
                "kind": "http",
                "method": "GET",
                "path": "/sessions/${thread}",
                "body": null,
                "headers": {},
                "status": 200,
                "assertions": [
                  {
                    "pointer": "/approval_status",
                    "operator": "equals",
                    "value": "${expected}"
                  }
                ],
                "capture": {}
              }
            ],
            "examples": [
              {
                "score": 0,
                "feedback": "评分为零，审核后批准。",
                "approved": true,
                "expected": "approved"
              }
            ],
            "matrix": {},
            "boundary": null,
            "contract": null
          },
