ARG RUST_IMAGE
ARG PYTHON_IMAGE
FROM ${RUST_IMAGE} AS rust
FROM ${PYTHON_IMAGE}
USER root
RUN sed -i "s|http://deb.debian.org|https://deb.debian.org|g" /etc/apt/sources.list.d/debian.sources && apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends build-essential pkg-config cmake git libssl-dev && rm -rf /var/lib/apt/lists/*
COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH CARGO_BUILD_JOBS=2
RUN cc --version && cargo --version && rustc --version && dpkg-query -W > /native-toolchain.lock
